<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, sans-serif" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Background" Value="#11151F" />
    <Setter Property="Foreground" Value="#E7EDF8" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="#151B29" />
    <Setter Property="BorderBrush" Value="#374359" />
    <Setter Property="Padding" Value="10,8" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="#151B29" />
    <Setter Property="BorderBrush" Value="#374359" />
  </Style>
  <Style Selector="Button">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="16,9" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="#6BA5FF" />
    <Setter Property="Foreground" Value="#0D1729" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="#253147" />
    <Setter Property="Foreground" Value="#E2EAF8" />
  </Style>
  <Style Selector="TabItem">
    <Setter Property="Padding" Value="18,12" />
    <Setter Property="FontSize" Value="14" />
  </Style>
</Styles>
